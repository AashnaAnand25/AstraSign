# SignBridge Backend Environment Variables
#
# Copy this file to `signbridge/backend/.env` and fill in real values.
# Never commit real credentials.

# Required (used for sign recognition + grammar + gloss-to-English)
GEMINI_API_KEY=

# Optional: required only for Whisper transcription endpoint (/api/transcribe)
# Preferred name (we still accept OPENAI_API_KEY as a legacy fallback)
WHISPERAI_KEY=
OPENAI_API_KEY=

# Optional: required only for text-to-speech endpoint (/api/speak)
ELEVENLABS_API_KEY=

# Optional: enables vocabulary save/load endpoints (/api/memory/*)
SUPERMEMORY_API_KEY=

# Server
PORT=8000
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081
