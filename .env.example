# Frontend environment variables.
# Copy to `.env` for local overrides, or set these in your host's dashboard
# (Aedify: Settings → Environment variables).

# Origin of the deployed FastAPI backend, with no trailing slash.
# Leave this UNSET for local development — requests then stay relative and the
# Vite dev server proxies /api to http://localhost:8000.
#
# Leaving it unset in production is also supported: the app detects that no
# backend is answering and falls back to on-device speech synthesis and the
# local rule-based ASL grammar. Sign detection and the 3D avatar are fully
# client-side and never need the backend.
#
# VITE_API_URL=https://astrasign-api.onrender.com
